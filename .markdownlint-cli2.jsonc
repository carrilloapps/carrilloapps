{
  // Markdown linting for the docs an agent actually reads. Everything here is
  // either auto-fixable or genuinely worth failing on, so `npm run lint:md`
  // and the pre-commit hook can repair issues instead of just reporting them.
  "globs": [
    "*.md",
    "docs/**/*.md",
    "specs/**/*.md",
    "src/**/*.md",
    ".github/**/*.md",
    ".specify/memory/*.md",
  ],
  "ignores": [
    "node_modules",
    ".next",
    // One-line pointers to AGENTS.md — a heading would break the @import.
    "CLAUDE.md",
    ".github/copilot-instructions.md",
    // Vendored agent payloads — regenerated by `npm run skills:all`, not ours.
    ".claude",
    ".agents",
    // spec-kit toolchain templates carry intentional [PLACEHOLDER] scaffolding.
    ".specify/templates",
    ".specify/scripts",
    ".specify/integrations",
    ".specify/workflows",
  ],
  "config": {
    "default": true,

    // Prettier owns wrapping (printWidth 100) and cannot reflow tables or long
    // URLs. Enforcing a second, conflicting width here just fights the formatter.
    "MD013": false,

    // Inline HTML is deliberate: JSX samples, <!-- BEGIN --> markers, and the
    // Next.js agent-rules block injected by `next dev`.
    "MD033": false,

    // Repeated headings are fine under different parents ("### Rules" appears
    // in several sections); duplicated siblings are still an error.
    "MD024": { "siblings_only": true },

    // Some files legitimately carry more than one top-level heading — AGENTS.md
    // ends with the injected "# This is NOT the Next.js you know" block.
    "MD025": false,

    // Ordered lists are written 1./2./3. in some docs and 1./1./1. in others;
    // both render identically and the fixer rewrites whichever style is used.
    "MD029": { "style": "ordered" },

    // Emphasis-as-heading is used for short callouts inside tables and lists.
    "MD036": false,

    // Prettier reformats every table on write; its alignment and this rule's
    // disagree, so the two would undo each other on every commit.
    "MD060": false,
  },
}
