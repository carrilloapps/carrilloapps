{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@colbymchenry/codegraph@latest", "serve", "--mcp"]
    },
    "ai-sync": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "-p", "ai-sync-cli@latest", "ai-sync-mcp"]
    },
    "docgraph": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "-p", "@carrilloapps/docgraph@latest", "docgraph-mcp", "serve"]
    },
    "stitch": {
      "type": "http",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${STITCH_API_KEY}"
      }
    },
    "cloudflare-api": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "cloudflare-docs": {
      "type": "http",
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "cloudflare-dns-analytics": {
      "type": "http",
      "url": "https://dns-analytics.mcp.cloudflare.com/mcp"
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--isolated",
        "--executablePath",
        "${CHROME_PATH:-chrome}",
        "--chromeArg=--no-sandbox"
      ]
    },
    "opengraph": {
      "type": "stdio",
      "command": "node",
      "args": [
        "--input-type=module",
        "-e",
        "import{createRequire}from'node:module';globalThis.require=createRequire(process.cwd()+'/');await import('opengraph-mcp/dist/server.mjs')"
      ]
    },
    "skill-rules": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "skill-rules@latest", "mcp"]
    },
    "openseo": {
      "type": "http",
      "url": "https://app.openseo.so/mcp"
    }
  }
}
