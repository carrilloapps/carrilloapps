{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@colbymchenry/codegraph", "serve", "--mcp"]
    },
    "ai-sync": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "-p", "ai-sync-cli", "ai-sync-mcp"]
    },
    "docgraph": {
      "command": "npx",
      "args": ["-y", "-p", "@carrilloapps/docgraph", "docgraph-mcp", "serve"]
    },
    "stitch": {
      "type": "http",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${STITCH_API_KEY}"
      }
    },
    "cloudflare-api": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "cloudflare-docs": {
      "type": "http",
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "cloudflare-dns-analytics": {
      "type": "http",
      "url": "https://dns-analytics.mcp.cloudflare.com/mcp"
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "opengraph": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "opengraph-mcp"]
    },
    "skill-rules": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "skill-rules", "mcp"]
    },
    "openseo": {
      "type": "http",
      "url": "https://app.openseo.so/mcp"
    }
  }
}
