{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "src/app/AGENTS.md",
    "src/components/AGENTS.md",
    "src/lib/data/AGENTS.md",
    "src/hooks/AGENTS.md",
    "src/lib/AGENTS.md",
    "src/types/AGENTS.md",
    "docs/README.md"
  ],
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["npx", "-y", "@colbymchenry/codegraph@latest", "serve", "--mcp"],
      "cwd": ".",
      "enabled": true,
      "timeout": 30000
    },
    "ai-sync": {
      "type": "local",
      "command": ["npx", "-y", "-p", "ai-sync-cli@latest", "ai-sync-mcp"],
      "enabled": true,
      "timeout": 30000
    },
    "docgraph": {
      "type": "local",
      "command": ["npx", "-y", "-p", "@carrilloapps/docgraph@latest", "docgraph-mcp", "serve"],
      "cwd": ".",
      "environment": {
        "DOCGRAPH_READ_ONLY": "1"
      },
      "enabled": true,
      "timeout": 30000
    },
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
      },
      "oauth": false,
      "enabled": true,
      "timeout": 30000
    },
    "cloudflare-api": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "cloudflare-dns-analytics": {
      "type": "remote",
      "url": "https://dns-analytics.mcp.cloudflare.com/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--isolated",
        "--chromeArg=--no-sandbox"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "opengraph": {
      "type": "local",
      "command": [
        "node",
        "--input-type=module",
        "-e",
        "import{createRequire}from'node:module';globalThis.require=createRequire(process.cwd()+'/');await import('opengraph-mcp/dist/server.mjs')"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 30000
    },
    "skill-rules": {
      "type": "local",
      "command": ["npx", "-y", "skill-rules@latest", "mcp"],
      "enabled": true,
      "timeout": 30000
    },
    "openseo": {
      "type": "remote",
      "url": "https://app.openseo.so/mcp",
      "enabled": true,
      "timeout": 30000
    }
  },
  "skills": {
    "paths": [".agents/skills"]
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  }
}
